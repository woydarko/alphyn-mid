# ─── Midnight network ────────────────────────────────────────────────────────
# Level 5 runs on Preprod (50 verifiable Preprod users). Set to `preview` only
# for local Preview testing.
MIDNIGHT_NETWORK=preprod
# Local proof server (Docker: midnightntwrk/proof-server:8.0.3)
PROOF_SERVER_URL=http://127.0.0.1:6300
# Preprod endpoints
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v3/graphql
MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network
# Preview endpoints (swap in if MIDNIGHT_NETWORK=preview)
# MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/api/v3/graphql
# MIDNIGHT_NODE_URL=https://rpc.preview.midnight.network
# Deployed contract address — REDEPLOY to Preprod and paste the new address here.
# (Old Preview address: 9afb6efaf563a9eceb7d97d9627ddb513432e9b67d8461eab151af553cd38be3)
ALPHYN_CONTRACT_ADDRESS=

# ─── AI strategy generation ──────────────────────────────────────────────────
OPENROUTER_API_KEY=
# Model slug, e.g. anthropic/claude-sonnet or any OpenRouter-hosted model
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ─── Price feed ──────────────────────────────────────────────────────────────
# CoinGecko (no key needed for basic) or Pyth Hermes REST base URL
PRICE_FEED_URL=https://api.coingecko.com/api/v3

# ─── Keeper ──────────────────────────────────────────────────────────────────
# Wallet seed/key used by the epoch runner (NEVER commit the real value)
KEEPER_WALLET_SEED=
EPOCH_INTERVAL_SECONDS=3600
